{
  "name": "call-assist",
  "version": "0.1.0",
  "description": "AI voice call assistant for dental offices",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "tunnel": "cloudflared tunnel run sticky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "keywords": [
    "ai",
    "voice",
    "twilio",
    "dental",
    "appointments"
  ],
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@fastify/formbody": "^8.0.2",
    "@fastify/websocket": "^11.2.0",
    "ai": "^6.0.141",
    "alawmulaw": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "googleapis": "^171.4.0",
    "groq-sdk": "^1.1.2",
    "nanoid": "^5.1.7",
    "pino-pretty": "^13.1.3",
    "sherpa-onnx-node": "^1.12.34",
    "twilio": "^5.13.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
