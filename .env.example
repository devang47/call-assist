# Server
PORT=3000
HOST=0.0.0.0
SERVER_URL=http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Deepgram (TTS only)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Groq (STT + LLM)
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=                           # Optional — obtained automatically via /api/auth/google
GOOGLE_CALENDAR_ID=primary

# Practice Configuration
PRACTICE_NAME=Smile Dental Clinic
PRACTICE_TIMEZONE=America/New_York
PRACTICE_PHONE=+1234567890
PRACTICE_ADDRESS=123 Main St, Suite 100, New York, NY 10001
PRACTICE_APPOINTMENT_DURATION_MINUTES=30
