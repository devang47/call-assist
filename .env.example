# Server
PORT=3000
HOST=0.0.0.0
SERVER_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/call-assist.db
CALL_LOG_DIR=./storage/call-logs

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_SIGNATURE_VALIDATION=false                # Set to true in production

# Deepgram (Flux STT + Aura TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Speech-to-text: "flux" (Deepgram streaming + turn detection) or "whisper" (Silero VAD + Groq Whisper)
STT_PROVIDER=flux
DEEPGRAM_STT_MODEL=flux-general-multi            # or flux-general-en
FLUX_LANGUAGE_HINTS=en,hi                        # multi model only
FLUX_EOT_THRESHOLD=0.7
FLUX_EAGER_EOT_THRESHOLD=0.5                     # speculative LLM start; 0 disables
FLUX_EOT_TIMEOUT_MS=5000

# Optional: Langfuse tracing (traces contain transcripts, i.e. patient PII)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Groq (LLM, + STT in whisper mode)
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GROQ_LLM_REASONING_EFFORT=none                   # use "low" for openai/gpt-oss-120b

# Voice tuning
SILENCE_TIMEOUT_MS=30000
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_S=0.2
VAD_MIN_SILENCE_DURATION_S=0.65
BARGE_IN_ENABLED=true

# Optional benchmark providers
OPENAI_API_KEY=
FAL_KEY=
MIMO_API_KEY=

# Google Calendar (shared OAuth app credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=                            # Fallback — per-practice tokens stored in DB
GOOGLE_CALENDAR_ID=primary                       # Fallback — per-practice calendar IDs stored in DB

# Practice Configuration (fallback — primary source is DB)
PRACTICE_NAME=Smile Dental Clinic
PRACTICE_TIMEZONE=America/New_York
PRACTICE_PHONE=+1234567890
PRACTICE_ADDRESS=123 Main St, Suite 100, New York, NY 10001
PRACTICE_APPOINTMENT_DURATION_MINUTES=30
